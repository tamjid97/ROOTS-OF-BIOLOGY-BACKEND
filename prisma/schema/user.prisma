model User {
  id             String     @id @default(uuid())
  studentId      String?    @unique // এটি অ্যাপ্রুভ হওয়ার পর বসবে
  name           String
  phoneNumber    String     @unique
  email          String?    @unique
  password       String
  profilePicture String?
  class          String
  institute      String
  role           Role       @default(USER)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  isApproved     IsApproved?
  status         Status     @default(ACTIVE)
  banner         Banner[]
  batch          Batch[]
  pdf            PdfTable[]
  picture        Picture[]
  Result         Result[]
  review         Review[]
}
model Result {
  id         String   @id @default(uuid())
  examName   String
  batch      String
  examDate   String
  resultLink String
  userID     String   // যে অ্যাডমিন/ইউজার এটি তৈরি করছে তার ID
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userID], references: [id])
}